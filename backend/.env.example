# Environment Configuration Example for SEOlytics AI Backend

APP_NAME="SEOlytics AI Backend"
APP_VERSION="1.0.0"
DEBUG=True
FRONTEND_URL="http://localhost:5173"

# AI Recommendation Provider Configuration (Optional)
# Options: 'builtin' (default expert engine), 'openai', 'gemini'
AI_PROVIDER="builtin"
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"

# External SEO & Search Intelligence Provider Configuration (Optional)
# Options: 'none' (default), 'serpapi', 'dataforseo', 'gsc'
SEO_API_PROVIDER="none"
SEO_API_KEY=""

# Security & Crawling Settings
CRAWLER_TIMEOUT_SECONDS=15
CRAWLER_MAX_REDIRECTS=5
ALLOW_PRIVATE_IPS=False # Leave False to enforce SSRF protection
